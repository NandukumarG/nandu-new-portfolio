# Optional: enables the contact form to prepare an email in the visitor's mail app.
# Without this setting, visitors can copy their project brief instead.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
# Optional: defaults to VITE_CONTACT_PHONE. Digits with country code, e.g. 917795711896
VITE_WHATSAPP_NUMBER=
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=
VITE_REDDIT_URL=
